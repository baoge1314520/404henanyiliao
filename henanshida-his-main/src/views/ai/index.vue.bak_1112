<template>
	<div class="ai-wrapper">
		<div class="ai-header">
			<span class="ai-title">AI 问答</span>
			<el-button type="danger" plain :icon="Delete" :disabled="loading" @click="clear">清空对话</el-button>
		</div>

		<div class="ai-body" ref="bodyRef">
			<div v-if="messages.length === 0" class="ai-empty">
				<el-icon :size="40"><ChatDotRound /></el-icon>
				<p>你好，我是 HIS 系统的 AI 助手，输入问题开始对话吧。</p>
			</div>
			<div v-for="(msg, i) in messages" :key="i" class="ai-row" :class="msg.role">
				<div class="ai-bubble">
					<span class="ai-role">{{ msg.role === 'user' ? '我' : (msg.role === 'error' ? '错误' : 'AI') }}</span>
					<div class="ai-text">{{ msg.text }}</div>
				</div>
			</div>
			<div v-if="loading" class="ai-row assistant">
				<div class="ai-bubble">
					<span class="ai-role">AI</span>
					<div class="ai-text ai-typing">正在思考…</div>
				</div>
			</div>
		</div>

		<div class="ai-footer">
			<el-input
				v-model="input"
				type="textarea"
				:autosize="{ minRows: 1, maxRows: 4 }"
				resize="none"
				placeholder="请输入问题，Enter 发送，Shift+Enter 换行"
				:disabled="loading"
				@keydown.enter.exact.prevent="send" />
			<el-button type="primary" :icon="Promotion" :loading="loading" :disabled="!input.trim()" @click="send">发送</el-button>
		</div>
	</div>
</template>

<script setup>
import { ref, nextTick, onMounted } from 'vue'
import { _axios } from '@/util/axios'
import { ElMessage } from 'element-plus'
import { Promotion, Delete, ChatDotRound } from '@element-plus/icons-vue'

const input = ref('')
const loading = ref(false)
const messages = ref([])
const bodyRef = ref(null)
const memoryId = ref('')

onMounted(() => {
	// 同一个浏览器标签页保持同一个会话 id，刷新后上下文还在；清空对话时换一个新的
	let id = sessionStorage.getItem('ai-memory-id')
	if (!id) {
		id = 'ai-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8)
		sessionStorage.setItem('ai-memory-id', id)
	}
	memoryId.value = id
})

function scrollBottom () {
	nextTick(() => {
		if (bodyRef.value) {
			bodyRef.value.scrollTop = bodyRef.value.scrollHeight
		}
	})
}

function send () {
	const text = input.value.trim()
	if (!text || loading.value) {
		return
	}
	messages.value.push({ role: 'user', text })
	input.value = ''
	loading.value = true
	scrollBottom()

	const formData = new FormData()
	formData.append('memoryId', memoryId.value)
	formData.append('message', text)
	_axios.request({
		url: '/ai/chat',
		method: 'POST',
		data: formData
	}).then(response => {
		if (response.data.code === 200) {
			messages.value.push({ role: 'assistant', text: response.data.content })
		} else {
			messages.value.push({ role: 'error', text: response.data.message || 'AI 服务返回错误' })
		}
	}).catch(error => {
		messages.value.push({ role: 'error', text: '请求失败：' + (error.message || '网络异常') })
	}).finally(() => {
		loading.value = false
		scrollBottom()
	})
}

function clear () {
	const formData = new FormData()
	formData.append('memoryId', memoryId.value)
	_axios.request({
		url: '/ai/clear',
		method: 'POST',
		data: formData
	}).then(response => {
		if (response.data.code === 200) {
			ElMessage.success(response.data.message || '已清空对话')
		}
	}).catch(error => {})
	// 无论后端是否成功，前端都重置会话，换一个新的 memoryId
	messages.value = []
	const id = 'ai-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8)
	sessionStorage.setItem('ai-memory-id', id)
	memoryId.value = id
}
</script>

<style scoped lang="scss">
.ai-wrapper {
	display: flex;
	flex-direction: column;
	height: calc(100vh - 120px);
	border: 1px solid #cccccc;
	border-radius: 6px;
	overflow: hidden;
}
.ai-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 10px 16px;
	border-bottom: 1px solid #cccccc;
	.ai-title {
		font-size: 16px;
		font-weight: bold;
	}
}
.ai-body {
	flex: 1;
	overflow-y: auto;
	padding: 16px;
	background: #f7f8fa;
}
.ai-empty {
	height: 100%;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	color: #909399;
	gap: 12px;
}
.ai-row {
	display: flex;
	margin-bottom: 14px;
	&.user {
		justify-content: flex-end;
		.ai-bubble {
			background: #ecf5ff;
			border-color: #d9ecff;
		}
	}
	&.assistant {
		justify-content: flex-start;
	}
	&.error {
		justify-content: flex-start;
		.ai-bubble {
			background: #fef0f0;
			border-color: #fde2e2;
		}
	}
}
.ai-bubble {
	max-width: 70%;
	padding: 8px 12px;
	background: #ffffff;
	border: 1px solid #e4e7ed;
	border-radius: 8px;
	.ai-role {
		display: block;
		font-size: 12px;
		color: #909399;
		margin-bottom: 4px;
	}
	.ai-text {
		white-space: pre-wrap;
		word-break: break-word;
		line-height: 1.6;
	}
	.ai-typing {
		color: #909399;
	}
}
.ai-footer {
	display: flex;
	align-items: flex-end;
	gap: 10px;
	padding: 12px 16px;
	border-top: 1px solid #cccccc;
	background: #ffffff;
	.el-textarea {
		flex: 1;
	}
}
</style>
<template>
	<el-space
		v-loading.fullscreen.lock="loading"
		direction="vertical"
		alignment="normal"
		size="large">
		<el-space>
			<el-input style="width: 200px;" v-model="name" placeholder="请输入要查询的科室名称" @keydown.enter.exact="search" />
			<el-button type="primary" plain :icon="Search" @click="search">查询</el-button>
			<el-button type="success" :icon="Plus" plain @click="add">添加</el-button>
		</el-space>
		<el-table :data="data.records" border>
			<el-table-column label="编号" prop="id"></el-table-column>
			<el-table-column label="科室名称" prop="deptName"></el-table-column>
			<el-table-column label="科室编号" prop="deptCode" show-overflow-tooltip></el-table-column>
			<el-table-column label="科室类别">
				<template #default="{row}"> {{dept_type_dict[row.deptType]}}</template>
			</el-table-column>
			<el-table-column label="状态">
				<template #default="{row}">
					<el-tag v-if="row.enabled" type="success">启动</el-tag>
					<el-tag v-else type="danger">禁用</el-tag>
				</template>
			</el-table-column>
			<el-table-column label="创建日期" prop="createDate"></el-table-column>
			<el-table-column label="创建时间" prop="createTime"></el-table-column>
			<el-table-column label="修改日期" prop="updateDate"></el-table-column>
			<el-table-column label="修改时间" prop="updateTime"></el-table-column>
			<el-table-column label="操作" width="120">
				<template #default="{row}">
					<el-button link type="primary" @click="edit(row)">修改</el-button>
					<el-button link :type="row.enabled ? 'danger' : 'success'" @click="toggle(row)">
						{{row.enabled ? '删除' : '启用'}}
					</el-button>
				</template>
			</el-table-column>
		</el-table>
		<el-pagination 
			background 
			:total="data.totalRow"
			:page-count="data.totalPage"
			v-model:current-page="params.pageNo"
			@current-change="getTableData"></el-pagination>
		<el-dialog
			v-model="visible" 
			:title="editRow ? '修改科室' : '添加科室'"
			:close-on-click-modal="false"
			width="500px">
			<dept-editor :row="editRow" @saved="onSaved" />
		</el-dialog>
	</el-space>
</template>

<script setup>
import { ref, reactive } from 'vue'
import { _axios } from '@/util/axios'
import { ElMessage, ElMessageBox } from 'element-plus'
import { Search, Plus } from '@element-plus/icons-vue'
import DeptEditor from './editor'
const loading = ref(false)
const visible = ref(false)
const editRow = ref(null)
const name = ref('')
const data = reactive({
	records: [],
	totalPage: 0,
	totalRow: 0
})
const params = reactive({
	pageNo: 1,
	pageSize: 10,
	name: ''
})
const dept_type_dict = {
	'1': '临床科室',
	'2': '行政科室',
	'3': '医技科室'
}
getTableData()
function getTableData () {
	loading.value = true
	_axios.request({
		url: '/sysDept/list',
		method: "GET",
		params: params
	}).then(response => {
		console.dir(response.data)
		if (response.data.code === 200) {
			if (response.data.message) {
				ElMessage.success(response.data.message)
			}
			data.records = response.data.content.records
			data.totalPage = response.data.content.totalPage
			data.totalRow = response.data.content.totalRow
		} else {
			ElMessage.error(response.data.message)
		}	
	}).catch(error => {
		
	}).finally(()=> {
		loading.value = false
	})
}
function search () {
	params.name = name.value
	params.pageNo = 1
	getTableData()
}
function add () {
	editRow.value = null
	visible.value = true
}
function edit (row) {
	editRow.value = row
	visible.value = true
}
function onSaved () {
	visible.value = false
	getTableData()
}
// 后端的 del 是软删除：enabled=false 禁用，enabled=true 启用，行不会真的删掉
function toggle (row) {
	const action = row.enabled ? '删除' : '启用'
	ElMessageBox.confirm(
		`确定${action}科室「${row.deptName}」吗？` + (row.enabled ? '删除只是禁用，数据仍保留。' : ''),
		'提示',
		{ type: 'warning', confirmButtonText: '确定', cancelButtonText: '取消' }
	).then(() => {
		loading.value = true
		const formData = new FormData()
		formData.append('id', row.id)
		formData.append('enabled', !row.enabled)
		_axios.request({
			url: '/sysDept/del',
			method: 'POST',
			data: formData
		}).then(response => {
			if (response.data.code === 200) {
				ElMessage.success(response.data.message)
				getTableData()
			} else {
				ElMessage.error(response.data.message)
			}
		}).catch(error => {
			
		}).finally(() => {
			loading.value = false
		})
	}).catch(() => {})
}
</script>

<style scoped lang="scss">
</style>